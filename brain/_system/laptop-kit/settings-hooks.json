{
  "_note": "Merge these into the laptop's ~/.claude/settings.json 'hooks' (append to existing arrays, keep other hooks). Replace <HOME> with the laptop user's profile dir, e.g. C:\\Users\\thebl (double the backslashes in JSON).",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "python \"<HOME>\\Brain\\_system\\brain.py\" guard", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python \"<HOME>\\Brain\\_system\\brain.py\" hook", "timeout": 5 },
        { "type": "command", "command": "node \"<HOME>\\.claude\\hooks\\context-guard.js\" prompt", "timeout": 5 }
      ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"<HOME>\\Brain\\_system\\brain.py\" autocommit", "timeout": 15 } ] }
    ],
    "SessionStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python \"<HOME>\\Brain\\_system\\brain.py\" session", "timeout": 5 } ] }
    ]
  }
}
